    "test:storage": "node scripts/test-storage.mjs",
    "test:scoped-migration": "node scripts/test-scoped-migration.mjs",
    "test:scripts": "node scripts/test-scripts.mjs",
    "test:rules": "node scripts/test-rules.mjs",
    "test:rules:e2e": "node scripts/test-rules-e2e.mjs",
    "test:ui-perf": "node scripts/test-ui-perf.mjs",
    "test:page-perf": "node scripts/test-page-perf.mjs",
    "test:probe": "node scripts/test-probe.mjs",
    "test:input": "node scripts/test-input.mjs",
    "test:dom": "node scripts/test-dom.mjs",
    "test:sessions": "node scripts/test-sessions.mjs",
    "test:workspaces": "node scripts/test-workspaces.mjs",
    "test:auth-ledger": "node scripts/test-auth-ledger.mjs",
    "test:extension-probe": "node scripts/probes/extension-management.mjs",
    "test:extensions": "node scripts/test-extensions.mjs",
    "test:actions": "node scripts/test-actions.mjs",
    "test:content": "node scripts/test-content-capture.mjs",
    "test:stream-content": "node scripts/test-stream-content.mjs",
    "test:stream-browser": "node scripts/probes/streaming-browser.mjs",
    "test:capture-paths": "node scripts/probes/capture-paths.mjs",
    "test:capture-cdp": "node scripts/probes/cdp-alternatives.mjs",
    "test:dock": "node scripts/test-dock.mjs",
    "test:layout": "node scripts/test-layout.mjs",
    "test:analytics": "node scripts/test-analytics.mjs",
    "test:realtime": "node scripts/test-realtime.mjs",
    "test:sitedata": "node scripts/test-sitedata.mjs",
    "test:smoke": "node scripts/test-smoke.mjs",
    "verify": "node scripts/verify-completeness.mjs",
    "demo": "node scripts/demo-run.mjs",
    "test:proxy": "node scripts/test-proxy.mjs",
    "test:correlate": "node scripts/test-correlate.mjs",
    "test:control": "node scripts/test-control.mjs",
    "test:detail": "node scripts/test-detail.mjs",
    "test:drill": "node scripts/test-agent-drill.mjs",
    "mcp": "node mcp/server.mjs",
    "dist:win": "electron-builder --win"
