{
  "name": "chromium-monitor-container",
  "version": "0.1.0",
  "private": true,
  "description": "高隐蔽性 Chromium 监控容器 — 观测与干预",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
